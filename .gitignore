**/.DS_Store
.idea
.phpunit.result.cache
.phpunit.cache
.vscode
build
coverage
# ⚠️ `docs/*`, NOT `docs` — git cannot re-include a file whose parent DIRECTORY is
# excluded, so the skeleton's blanket `docs` made the negations below dead and
# silently swallowed the design spec. Excluding the directory's CONTENTS instead
# lets `!docs/superpowers/` actually work.
docs/*
!docs/superpowers/
node_modules
phpunit.xml
phpstan.neon
testbench.yaml
vendor

# Playwright MCP scratch output (browser verification runs)
.playwright-mcp

# Installed agent tooling — the same category as vendor/ and node_modules/ above:
# generated by an installer, not hand-written, and reinstallable from
# .specify/init-options.json (spec-kit 0.12.4).
#
# ⚠️ `.specify/*`, NOT `.specify` — same trap as `docs/*` above. Git cannot
# re-include a file whose parent DIRECTORY is excluded, so the carve-outs below
# would be silently dead.
.claude/
.specify/*
!.specify/memory/
!.specify/extensions.yml
