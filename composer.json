{
    "name": "rolland97/filament-tours",
    "description": "Guided product tours for Filament panels, powered by driver.js.",
    "keywords": [
        "rolland97",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-tours"
    ],
    "homepage": "https://github.com/rolland97/filament-tours",
    "support": {
        "issues": "https://github.com/rolland97/filament-tours/issues",
        "source": "https://github.com/rolland97/filament-tours"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Rolland Son",
            "email": "rollandson26@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Rolland\\FilamentTours\\": "src/",
            "Rolland\\FilamentTours\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rolland\\FilamentTours\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rolland\\FilamentTours\\FilamentToursServiceProvider"
            ],
            "aliases": {
                "FilamentTours": "Rolland\\FilamentTours\\Facades\\FilamentTours"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}